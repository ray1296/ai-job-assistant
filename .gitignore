# Explicit allowlisted project repository; original reference projects stay local
/*
!/.gitignore
!/README.md
!/docs/
!/prototype/
!/app/
**/node_modules/
**/dist/
**/.env
**/.env.*
!**/.env.example
**/*.sqlite*
**/*.db
**/data/
!/app/data/
/app/data/*
!/app/public/
!/app/data/jobs-catalog.json
!/app/data/jobs-identities.json
!/app/data/jobs-manifest.json
!/app/data/learning-catalog.json
!/app/data/learning-manifest.json
!/app/data/rag-eval.json
!/app/data/finetune/
!/app/data/finetune/**
!/app/data/housing-catalog.json
!/app/data/companies-catalog.json
**/uploads/
**/private/
**/*.log
**/*credentials*
**/artifacts/
**/.tools/
**/__pycache__/
prototype/public/app.js
prototype/public/legacy.js
prototype/public/legacy.css

# 新外观项目：源码进仓库，运行时资产仍忽略
!/app-redesign/
!/app-redesign/**
/app-redesign/node_modules/
/app-redesign/private/
/app-redesign/dist/
/app-redesign/.tools/
/app-redesign/artifacts/
/app-redesign/*.log

# 内部文档：只保留在工作区，不进入公开仓库
/PROJECT_MEMORY.md
/HANDOFF.md
/app-redesign/HANDOFF.md
/docs/COMPETITION_*.md
