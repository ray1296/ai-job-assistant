# Explicit allowlisted project repository; original reference projects stay local
/*
!/.gitignore
!/PROJECT_MEMORY.md
!/README.md
!/docs/
!/prototype/
!/app/
**/node_modules/
**/dist/
**/.env
**/.env.*
!**/.env.example
**/*.sqlite*
**/data/
!/app/data/
/app/data/*
!/app/data/jobs-catalog.json
!/app/data/jobs-identities.json
!/app/data/jobs-manifest.json
!/app/data/learning-catalog.json
!/app/data/learning-manifest.json
**/uploads/
**/private/
**/*.log
**/*credentials*
**/artifacts/
**/.tools/
**/__pycache__/
prototype/public/app.js
prototype/public/legacy.js
prototype/public/legacy.css
