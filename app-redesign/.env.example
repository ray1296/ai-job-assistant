# ===== 服务端口 =====
PORT=5173
HTTPS_PORT=5175
HTTP_PORT=5176
HOST=0.0.0.0

# ===== 目录 =====
# 私有数据（数据库、证书、密钥）；必须 .gitignore
CAREER_DATA_DIR=./private
# 前端构建产物
CAREER_STATIC_DIR=./dist
# 构建输出目录（build.mjs 使用）
BUILD_OUT_DIR=dist

# ===== 安全 =====
# 仅在确认走 HTTPS 反向代理后设为 true
CAREER_SECURE_COOKIE=false
# 1 分钟负载超过该值时拒绝 OCR/视觉任务
CAREER_MAX_LOAD=1.8

# ===== 外部依赖 =====
# 服务端导出 PDF 用的 Chromium 路径（不填则自动探测常见路径）
CHROME_PATH=
# 高德 REST Key（也可写在 private/geo-config.json）
AMAP_KEY=

# ===== 初始化管理员（仅首次启动生效）=====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ===== 并发 =====
INTERVIEW_MAX_ACTIVE=2
